{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Divinari/divinari-developer-resources/schemas/lexicon-entry.schema.json",
  "title": "Divinari Public Lexicon Dataset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "language_code",
    "translation_language_code",
    "license",
    "origin_type",
    "source_citation",
    "contributors",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "language_code": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "translation_language_code": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "license": {
      "type": "string",
      "enum": [
        "CC-BY-4.0",
        "CC0-1.0"
      ]
    },
    "origin_type": {
      "type": "string",
      "enum": [
        "native_speaker",
        "public_domain",
        "cc_by_4_0"
      ]
    },
    "source_citation": {
      "type": "string",
      "minLength": 3
    },
    "contributors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "concept_key",
          "sense_key",
          "term",
          "normalized_term",
          "part_of_speech",
          "gloss",
          "definition",
          "register",
          "verification_status"
        ],
        "properties": {
          "concept_key": {
            "type": "string",
            "pattern": "^[A-Z0-9_]+$"
          },
          "sense_key": {
            "type": "string",
            "minLength": 1
          },
          "term": {
            "type": "string",
            "minLength": 1
          },
          "normalized_term": {
            "type": "string",
            "minLength": 1
          },
          "part_of_speech": {
            "type": "string",
            "enum": [
              "noun",
              "verb",
              "adjective",
              "adverb",
              "pronoun",
              "particle",
              "conjunction",
              "preposition",
              "interjection",
              "phrase"
            ]
          },
          "gloss": {
            "type": "string",
            "minLength": 1
          },
          "definition": {
            "type": "string",
            "minLength": 3
          },
          "register": {
            "type": "string",
            "enum": [
              "standard",
              "formal",
              "casual",
              "regional",
              "liturgical",
              "archaic"
            ]
          },
          "pronunciation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "syllabic",
              "ipa"
            ],
            "properties": {
              "syllabic": {
                "type": "string",
                "minLength": 1
              },
              "ipa": {
                "type": "string",
                "minLength": 2
              }
            }
          },
          "forms": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "surface",
                "grammatical_role"
              ],
              "properties": {
                "surface": {
                  "type": "string",
                  "minLength": 1
                },
                "grammatical_role": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "examples": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sentence_text",
                "translation"
              ],
              "properties": {
                "sentence_text": {
                  "type": "string",
                  "minLength": 3
                },
                "translation": {
                  "type": "string",
                  "minLength": 3
                },
                "tokens": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "surface",
                      "char_start",
                      "char_end"
                    ],
                    "properties": {
                      "surface": {
                        "type": "string",
                        "minLength": 1
                      },
                      "char_start": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "char_end": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "lemma": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "usage_note": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "verification_status": {
            "type": "string",
            "enum": [
              "native-reviewed",
              "linguist-reviewed"
            ]
          }
        }
      }
    }
  }
}
