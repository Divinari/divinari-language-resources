{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Divinari/divinari-developer-resources/schemas/writing-system.schema.json",
  "title": "Divinari Public Writing System Stroke Specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "script_id",
    "script_name",
    "language_codes",
    "license",
    "origin_type",
    "source_citation",
    "contributors",
    "characters"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "script_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "script_name": {
      "type": "string",
      "minLength": 2
    },
    "language_codes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "unicode_block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "string",
          "pattern": "^U\\+[0-9A-F]{4,6}$"
        },
        "end": {
          "type": "string",
          "pattern": "^U\\+[0-9A-F]{4,6}$"
        }
      }
    },
    "license": {
      "type": "string",
      "enum": [
        "CC-BY-4.0",
        "CC0-1.0"
      ]
    },
    "origin_type": {
      "type": "string",
      "enum": [
        "native_speaker",
        "public_domain",
        "cc_by_4_0"
      ]
    },
    "source_citation": {
      "type": "string",
      "minLength": 3
    },
    "contributors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "characters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "character_id",
          "glyph",
          "romanization",
          "category",
          "codepoints",
          "stroke_count",
          "strokes"
        ],
        "properties": {
          "character_id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "glyph": {
            "type": "string",
            "minLength": 1
          },
          "romanization": {
            "type": "string",
            "minLength": 1
          },
          "ipa": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "vowel",
              "consonant",
              "syllable",
              "diacritic"
            ]
          },
          "codepoints": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^U\\+[0-9A-F]{4,6}$"
            }
          },
          "stroke_count": {
            "type": "integer",
            "minimum": 1
          },
          "mnemonic": {
            "type": "string"
          },
          "strokes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "stroke_index",
                "points"
              ],
              "properties": {
                "stroke_index": {
                  "type": "integer",
                  "minimum": 1
                },
                "points": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "x",
                      "y"
                    ],
                    "properties": {
                      "x": {
                        "type": "number",
                        "minimum": 0.0,
                        "maximum": 1.0
                      },
                      "y": {
                        "type": "number",
                        "minimum": 0.0,
                        "maximum": 1.0
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
