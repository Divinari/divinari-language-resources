{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Divinari/divinari-developer-resources/schemas/heritage-contribution.schema.json",
  "title": "Divinari Public Heritage Contribution",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contribution_id",
    "language_code",
    "region",
    "title",
    "cultural_summary",
    "glossary_terms",
    "care_ethics_confirmed",
    "license",
    "origin_type",
    "source_citation",
    "contributors"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "contribution_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "language_code": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "region": {
      "type": "string",
      "minLength": 2
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "cultural_summary": {
      "type": "string",
      "minLength": 10
    },
    "glossary_terms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "term",
          "meaning"
        ],
        "properties": {
          "term": {
            "type": "string",
            "minLength": 1
          },
          "meaning": {
            "type": "string",
            "minLength": 2
          }
        }
      }
    },
    "media": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "creator",
          "license",
          "source_url"
        ],
        "properties": {
          "creator": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "type": "string",
            "enum": [
              "CC0-1.0",
              "CC-BY-4.0",
              "synthetic-placeholder"
            ]
          },
          "source_url": {
            "type": "string",
            "minLength": 5
          }
        }
      }
    },
    "care_ethics_confirmed": {
      "type": "boolean",
      "const": true
    },
    "license": {
      "type": "string",
      "enum": [
        "CC-BY-4.0",
        "CC0-1.0"
      ]
    },
    "origin_type": {
      "type": "string",
      "enum": [
        "native_speaker",
        "public_domain",
        "cc_by_4_0"
      ]
    },
    "source_citation": {
      "type": "string",
      "minLength": 3
    },
    "contributors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
