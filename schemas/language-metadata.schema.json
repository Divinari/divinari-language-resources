{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Divinari/divinari-developer-resources/schemas/language-metadata.schema.json",
  "title": "Divinari Public Language Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "language_code",
    "iso_639_3",
    "english_name",
    "autonym",
    "script_names",
    "writing_direction",
    "status",
    "verified_entry_count",
    "license",
    "origin_type",
    "source_citation",
    "attribution"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "language_code": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "iso_639_3": {
      "type": "string",
      "pattern": "^[a-z]{3}$"
    },
    "iso_639_1": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z]{2}$"
    },
    "english_name": {
      "type": "string",
      "minLength": 2
    },
    "autonym": {
      "type": "string",
      "minLength": 1
    },
    "region_notes": {
      "type": "string"
    },
    "script_names": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "writing_direction": {
      "type": "string",
      "enum": [
        "ltr",
        "rtl"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "scaffold",
        "pilot",
        "active"
      ]
    },
    "verified_entry_count": {
      "type": "integer",
      "minimum": 0
    },
    "license": {
      "type": "string",
      "enum": [
        "CC-BY-4.0",
        "CC0-1.0"
      ]
    },
    "origin_type": {
      "type": "string",
      "enum": [
        "maintainer_scaffold",
        "native_speaker",
        "public_domain",
        "cc_by_4_0"
      ]
    },
    "source_citation": {
      "type": "string",
      "minLength": 3
    },
    "attribution": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "role"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "handle": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
